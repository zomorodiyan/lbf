.git
*.o
*.dep
lnInclude
log.*

# Tutorial case data — not needed to build the solver
# Depth-agnostic (**) so these still match after cases moved into
# subdirectories (vdep/, plc/, etc.) instead of sitting directly under
# tutorials/laserbeamFoam/. [0-9]* covers all OpenFOAM time-dir naming
# styles (0.0001, 4e-06, 1.2e-05, ...), not just ones starting with "0.".
tutorials/**/[0-9]*/
tutorials/**/processor*/
tutorials/**/VTKs/*.vtk
tutorials/**/gif*/
tutorials/**/log.*
tutorials/**/results/
tutorials/**/*.gif
tutorials/**/*.mp4
tutorials/**/*.png
tutorials/**/*.pvsm
