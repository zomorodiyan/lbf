FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh   dynamicRefineFvMesh;

refineInterval  1;

// Refine on condensate (metal VOF sum — non-zero where metal exists)
field           condensate;

lowerRefineLevel 0.01;
upperRefineLevel 0.99;
unrefineLevel   0.01;

nBufferLayers   1;

// 1 level: 200 um base -> 100 um finest at metal/gas interface
maxRefinement   1;

maxCells        2000000;

correctFluxes
(
    (phi             none)
    (nHatf           none)
    (rhoPhi          none)
    (alphaPhi0.metal none)
    (ghf             none)
    (alphaPhiUn      none)
    (rhophicp        none)
    (phi_0           none)
);

dumpLevel       true;

