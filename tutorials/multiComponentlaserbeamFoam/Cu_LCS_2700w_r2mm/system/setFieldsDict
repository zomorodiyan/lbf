FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// x=0       to x=4000um: Cu (Grade 110) — beam center at x=2500um (1.5mm from interface)
// x=4000um  to x=5000um: low-carbon steel
// y=0       to y=400um:  gas below (free atmosphere)
// y=400um   to y=1600um: metal substrate 1.2 mm
// y=1600um  to y=2000um: gas above surface (atmosphere + laser entry)
// Interface at x=3500um, parallel to y-z plane. Laser scans along z (parallel to interface).
//

defaultFieldValues
(
    volScalarFieldValue alpha.air   1
    volScalarFieldValue alpha.Cu    0
    volScalarFieldValue alpha.steel 0
    volVectorFieldValue U           (0 0 0)
);

regions
(
    // Cu: x in [0, 4000um], y in [400um, 1600um], full z
    boxToCell
    {
        box (0 400e-6 0) (4000e-6 1600e-6 6000e-6);
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.Cu    1
            volScalarFieldValue alpha.steel 0
        );
    }

    // Steel: x in [4000um, 5000um], y in [400um, 1600um], full z
    boxToCell
    {
        box (4000e-6 400e-6 0) (5000e-6 1600e-6 6000e-6);
        fieldValues
        (
            volScalarFieldValue alpha.air   0
            volScalarFieldValue alpha.Cu    0
            volScalarFieldValue alpha.steel 1
        );
    }
);

