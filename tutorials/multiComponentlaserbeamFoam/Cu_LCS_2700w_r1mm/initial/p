FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 1e5;
boundaryField
{
    topWall     { type calculated; value $internalField; }
    bottomWall  { type calculated; value $internalField; }
    leftWall    { type calculated; value $internalField; }
    rightWall   { type calculated; value $internalField; }
    front       { type calculated; value $internalField; }
    back        { type calculated; value $internalField; }
}
