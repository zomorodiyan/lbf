FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    topWall
    {
        type    pressureInletOutletVelocity;
        phi     phi;
        rho     rho;
        value   uniform (0 0 0);
    }
    bottomWall
    {
        type    pressureInletOutletVelocity;
        phi     phi;
        rho     rho;
        value   uniform (0 0 0);
    }
    leftWall    { type fixedValue; value uniform (0 0 0); }
    rightWall   { type fixedValue; value uniform (0 0 0); }
    front       { type fixedValue; value uniform (0 0 0); }
    back        { type fixedValue; value uniform (0 0 0); }
}

