FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Interface tracking method: isoAdvector or MULES
interfaceTrackingScheme isoAdvector;

phases          (metal gas);

metal
{
    transportModel  Newtonian;
nu              7.0e-07;   // Al 6061 liquid: ~1.9 mPa.s / 2700 kg/m3

rho             2700;      // Al 6061 density, kg/m3

    Tsolidus 855;          // Al 6061 solidus, K
    Tliquidus 925;         // Al 6061 liquidus, K
    LatentHeat 3.97e5;     // Al 6061 fusion latent heat, J/kg
    beta    2.34e-5;       // Al 6061 liquid thermal expansion, 1/K
    poly_kappa   (167 0.0 0 0 0 0 0 0);  // Al 6061 solid, flat ~167 W/(m.K) (valid <= Tsolidus)
    poly_kappa_liquid   (129.8284 -0.06195669 3.615785e-05 -1.331106e-08 3.292607e-12 -5.355200e-16 5.177571e-20 -2.247075e-24);
    // Al 6061 liquid: blended with poly_kappa above via the solver's liquid
    // fraction field (epsilon1). Fitted to 95 W/(m.K) at Tliquidus (925K)
    // declining smoothly to ~78 W/(m.K) approaching Tvap (2743K); minimax
    // fit error over 925-4000K is ~8e-5 W/(m.K) (essentially exact).
    poly_cp   (896 0.0 0 0 0 0 0 0);    // Al 6061 specific heat, J/(kg.K)
    elec_resistivity	2.5e-7;  // Al 6061 liquid, Ohm.m (affects Drude absorptivity)
}

gas
{
    transportModel  Newtonian;

nu              1.48e-05;

rho             1;

    poly_kappa   (0.04 0 0 0 0 0 0 0);
    poly_cp   (520 0.0 0 0 0 0 0 0);

    Tsolidus    1.0;
    Tliquidus   10.0;
    LatentHeat  1;
    beta    4.0e-5;
}



sigma            0.87;      // Al 6061 at liquidus, N/m
Marangoni_Constant	-1.5e-4;   // Al 6061 dsigma/dT, N/(m.K)
p0	1e5;
Tvap	2743;          // Al 6061 vaporization temperature, K (pure Al, ~96% Al)
Mm	0.027;         // Al 6061 molar mass, kg/mol
LatentHeatVap 1.09e7;  // Al vaporization latent heat, J/kg
emS                     0.09;  // Al 6061 solid emissivity
emL                     0.10;  // Al 6061 liquid emissivity
TRef                    TRef [0 0 0 1 0 0 0]   300;
// ************************************************************************* //
