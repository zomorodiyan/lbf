(
    lowerWall
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }
    atmosphere
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
    rightWall
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    leftWall
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    frontAndBack
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (5 6 7 4)
        );
    }
);

