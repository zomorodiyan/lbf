    ( 0.25 0.5 0)  //2
    (-0.25 0.5 0)  //3
    (-0.25 0 3.2)  //4
    ( 0.25 0 3.2)  //5
    ( 0.25 0.5 3.2)//6
    (-0.25 0.5 3.2)//7
