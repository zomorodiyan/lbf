FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

V_incident	(0 1 0);//NORMALISED IN CODE

laserRadius 3.5e-5;


nRadial	10;
nAngular	36;


wavelength	1.064e-6;
e_num_density	1.81e29;  // Al: 3 free electrons/atom, n_e = 3 * N_A * 2700/0.027
//elec_resistivity	1.0e-6;


Radius_Flavour	0.7;  // = 2/M2 = 2/2.857 -- testrun70 remedy: was 1.336 (M2=1.497),
                      // lowered to flatten the beam profile (~48% lower peak
                      // intensity) without changing laserRadius. See task_Aug4.md.

useLocalSearch    true;//false;

//N_sub_divisions    6;
