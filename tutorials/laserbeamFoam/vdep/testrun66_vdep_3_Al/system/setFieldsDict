FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0
);

regions
(
    boxToCell
    {
        box (-1 0.0002 -1) (1 0.0005 1);  // metal: y=0.2mm to 0.5mm; 0.2mm gas above
        fieldValues
        (
            volScalarFieldValue alpha.metal 1
        );
    }
);

