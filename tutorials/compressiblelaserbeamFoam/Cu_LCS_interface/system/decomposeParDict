FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains  8;

method              hierarchical;

hierarchicalCoeffs
{
    n               (4 1 2);   // 4 in x, 1 in y, 2 in z — balanced for 25x10x30 mesh
    delta           0.001;
    order           xyz;
}

