FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh   dynamicRefineFvMesh;

// Refine every time step
refineInterval  1;

// Refine on the condensate field (metal VOF)
field           condensate;

lowerRefineLevel 0.01;
upperRefineLevel 0.99;
unrefineLevel   0.01;

// 1 buffer layer keeps 2:1 ratio
nBufferLayers   1;

// 1 level: 100 -> 50 um
maxRefinement   1;

maxCells        2000000;

correctFluxes
(
    (phi             none)
    (nHatf           none)
    (rhoPhi          none)
    (alphaPhi0.metal none)
    (ghf             none)
    (alphaPhiUn      none)
    (rhophicp        none)
    (phi_0           none)
);

dumpLevel       true;

// ************************************************************************* //
